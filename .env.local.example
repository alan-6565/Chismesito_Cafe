# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — the cafe's own account, Developers > API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared password for /admin/orders and /admin/billing
ADMIN_PASSWORD=

# Resend — resend.com, for order confirmation emails (optional; emails are
# skipped silently if this is unset)
RESEND_API_KEY=

# Sender address for confirmation emails. Leave unset to use Resend's
# onboarding@resend.dev sandbox sender, which can ONLY deliver to the email
# on the Resend account — not to real customers. Set this once a domain is
# verified in Resend (Domains > Add Domain), e.g.:
# RESEND_FROM_ADDRESS="Chismesito Cafe <orders@chismesitocafe.com>"
RESEND_FROM_ADDRESS=
